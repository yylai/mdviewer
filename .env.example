# Microsoft Azure App Registration
# Get this from https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
VITE_MSAL_CLIENT_ID=your-client-id-here

# X ingestion CLI
# User access token with bookmark.read, like.read, tweet.read, and users.read scopes.
X_ACCESS_TOKEN=your-x-user-access-token-here

# Optional: omit to let the CLI call /2/users/me.
X_USER_ID=

# Optional: defaults to data/x-archive.sqlite.
X_INGEST_DB_PATH=
